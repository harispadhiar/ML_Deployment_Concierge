name: Sync to Hugging Face Hub

on:
  push:
    branches: [main]

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      # Crucial: explicitly tell GitHub to pull down full LFS files
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          lfs: true

      - uses: huggingface/hub-sync@v0.1.0
        with:
          github_repo_id: ${{ github.repository }}
          huggingface_repo_id: harispadhiar/ML_Deployment_Concierge
          hf_token: ${{ secrets.HF_TOKEN }}
